github:
  org: my-org
  token_env: GH_PAT

host:
  reserve:
    cpu: 2
    memory_gb: 8

goldens:
  macos:
    xcodes:
      - version: "27.2"
      - version: "26.5"
    default_xcode: "27.2"
    simulators:
      - platform: iOS
        version: "27.0"
        xcode: "27.2"
        devices:
          - name: iPhone 17 Pro Max
            device_type: com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro-Max
      - platform: iOS
        version: "18.6"
        xcode: "26.5"
        devices:
          - name: iPhone 16 (iOS 18.6)
            device_type: com.apple.CoreSimulator.SimDeviceType.iPhone-16

runners:
  - name: macos
    kind: macos
    image: macos
    count: 2
    ephemeral: true
    resources:
      cpu: 3
      memory_gb: 10
      disk_gb: 180
    labels: [self-hosted, macos, arm64, xcode, android]

  - name: ubuntu
    kind: linux
    image: ubuntu
    count: 1
    ephemeral: true
    resources:
      cpu: 2
      memory_gb: 4
      disk_gb: 40
    labels: [self-hosted, linux, arm64, node, python, rust]
