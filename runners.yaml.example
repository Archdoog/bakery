github:
  org: my-org
  token_env: GH_PAT

host:
  reserve:
    cpu: 2
    memory_gb: 8

runners:
  - name: macos
    kind: macos
    image: macos
    count: 2
    ephemeral: true
    resources:
      cpu: 3
      memory_gb: 10
      disk_gb: 180
    labels: [self-hosted, macos, arm64, xcode, android]

  - name: ubuntu
    kind: linux
    image: ubuntu
    count: 1
    ephemeral: true
    resources:
      cpu: 2
      memory_gb: 4
      disk_gb: 40
    labels: [self-hosted, linux, arm64, node, python, rust]
